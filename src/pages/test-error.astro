---
import Base from '../layouts/Base.astro';

// This is a test page to verify error boundary functionality
---

<Base title="Error Boundary Test">
  <div class="space-y-6">
    <h1 class="text-2xl font-semibold">Error Boundary Test Page</h1>
    
    <div class="bg-blue-900/20 border border-blue-700 rounded-lg p-4">
      <h2 class="font-medium text-blue-300 mb-2">✅ Error Boundary Component</h2>
      <p class="text-blue-200 text-sm">The ErrorBoundary component has been successfully created and is ready to catch errors.</p>
    </div>
    
    <div class="bg-green-900/20 border border-green-700 rounded-lg p-4">
      <h2 class="font-medium text-green-300 mb-2">✅ Global Error Handler</h2>
      <p class="text-green-200 text-sm">Global error tracking has been initialized in Base.astro layout.</p>
    </div>
    
    <div class="bg-purple-900/20 border border-purple-700 rounded-lg p-4">
      <h2 class="font-medium text-purple-300 mb-2">✅ Error Logging Endpoint</h2>
      <p class="text-purple-200 text-sm">Error logging endpoint is available at /api/log-error</p>
    </div>
    
    <div class="bg-yellow-900/20 border border-yellow-700 rounded-lg p-4">
      <h2 class="font-medium text-yellow-300 mb-2">📝 Next Steps</h2>
      <ul class="text-yellow-200 text-sm space-y-1">
        <li>✅ ErrorBoundary.jsx created</li>
        <li>✅ ErrorBoundary.astro wrapper created</li>
        <li>✅ errorTracking.js utility created</li>
        <li>✅ Error logging endpoint created</li>
        <li>✅ Base.astro updated with error tracking initialization</li>
        <li>✅ ProtectedLayout.tsx wrapped with ErrorBoundary</li>
        
        <li>🔄 Wrap other React components with ErrorBoundary</li>
        <li>🔄 Add comprehensive error tracking documentation</li>
        <li>🔄 Create error tracking dashboard</li>
      </ul>
    </div>
    
    <!-- Test component that will throw an error -->
    <div class="bg-red-900/20 border border-red-700 rounded-lg p-4">
      <h2 class="font-medium text-red-300 mb-2">🧪 Test Error Boundary</h2>
      <p class="text-red-200 text-sm mb-3">This component will throw an error to test the error boundary:</p>
      
      <button 
        onclick="throwError()"
        class="px-4 py-2 bg-red-700 hover:bg-red-600 text-white rounded transition-colors"
      >
        Throw Test Error
      </button>
      
      <script>
        function throwError() {
          try {
            // This will throw an error that should be caught by the error boundary
            throw new Error('Test error from button click');
          } catch (error) {
            console.error('Caught error:', error);
            alert('Error thrown! Check console for error boundary test.');
          }
        }
      </script>
    </div>
  </div>
</Base>