# pnpm configuration
# Approve build scripts for packages that require them
# This is needed for esbuild and sharp which are used in the build process

# Global ignore-scripts setting (applies to all packages)
ignore-scripts=false

# Approve specific packages to run build scripts
# These packages are required for the Astro build process
shamefully-hoist=true

# Alternative approach: approve specific packages
# pnpm config set allow-build-scripts[0] esbuild
# pnpm config set allow-build-scripts[1] sharp

# Enable global bin directory for pnpm
global-bin-dir=/home/runner/.pnpm-global/bin

# Enable strict peer dependencies
strict-peer-dependencies=false
