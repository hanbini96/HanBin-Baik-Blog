# pnpm configuration for pnpm 11+ compatibility
# Approve build scripts for packages that require them
# This is needed for esbuild and sharp which are used in the Astro build process

# Global ignore-scripts setting (applies to all packages)
# pnpm 11+ defaults to true for security, we set to false to allow build scripts
ignore-scripts=false

# Approve specific packages to run build scripts
# These packages are required for the Astro build process
shamefully-hoist=true

# Allow build scripts for esbuild and sharp (required by Astro)
# This works with pnpm 11+ security model
allow-build-scripts[0]=esbuild
allow-build-scripts[1]=sharp

# Enable global bin directory for pnpm
global-bin-dir=/home/runner/.pnpm-global/bin

# Disable strict peer dependencies to avoid installation issues
strict-peer-dependencies=false

# Set Node.js engine requirement
engine-strict=true
